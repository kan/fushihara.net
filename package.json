{
  "name": "fushihara-net",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:roji": "roji run fushihara -- vite dev --port {port} --strictPort",
    "build": "wrangler types && tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "wrangler types && tsc -b"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@kanf/wema": "^0.16.0",
    "simple-icons": "^16.35.0"
  }
}
