{
  // E2E は Node の上で動き、page.evaluate() の中だけがブラウザ。src/ (Workers の
  // ランタイム型) と同じプロジェクトには入れられないので分ける。
  //
  // **分けたうえで typecheck から呼ぶこと。** ここが型検査の外にあると、
  // src/ の export を変えても E2E が壊れたことに Playwright を回すまで気付けない。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true
  },
  // **lily は `@kanf/lily/paths` と `/zip` のサブパスから読む。** バレル
  // (`@kanf/lily`) を読むと core 一式が入り、workerd のランタイム型が要るので
  // この lib（DOM 入り）では型検査できない —— `Request` / `Response` の宣言が
  // 二重になる。あの 2 つは Workers の型を 1 つも使わないので、ここから読める。
  "include": ["e2e", "playwright.config.ts", "src/site/meta.ts", "../shared/theme.ts"]
}
