# ローカル (wrangler dev / E2E) 専用の上書き。**デプロイには含まれない。**
#
# wrangler.jsonc の vars には本番の Cloudflare Access の設定が入っている。
# それをそのままローカルにも効かせると、手元には JWT が無いので管理 API が
# 403 になり、**E2E がフィクスチャを入れられない**（実際に落ちた）。
#
# 空にすると src/config.ts の authMode() が localhostOnly を選ぶ。これは
# host が localhost / 127.0.0.1 のときだけ通すアダプタなので、手元では開き、
# 実ドメインでは開かない。Access を手元で再現できない以上、この経路が要る。
#
# **秘密は何も入っていない**ので git 管理下に置いてある。CI もこれを読む
# （読まないと E2E が CI でだけ落ちる）。
ACCESS_TEAM=
ACCESS_AUD=

# Bluesky の告知も同じ理由で打ち消す。**手元やテストの操作が本物のタイムラインへ
# 流れない**ようにするためで、空だと src/config.ts が null を返し、管理画面の
# 告知ボタンは「未設定」と言う。本番のハンドルは wrangler.jsonc の vars、
# App Password は Worker の secret（どちらもここには要らない）。
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
