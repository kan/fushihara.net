---
import Base from '../layouts/Base.astro';
import { publishedPosts } from '../lib/posts';
import { postHref } from '../lib/paths';
import { pageTitle } from '../lib/site';
import PostDate from '../components/PostDate.astro';

const posts = await publishedPosts();
---

<Base title={pageTitle()}>
  {posts.length === 0 && <p class="post-summary">まだ記事がありません。</p>}

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <div class="post-meta">
          <PostDate date={post.data.date} />
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          {post.data.draft && <span class="tag">draft</span>}
        </div>
        <h2><a href={postHref(post.id)}>{post.data.title}</a></h2>
        {post.data.description && <p class="post-summary">{post.data.description}</p>}
      </li>
    ))}
  </ul>
</Base>
