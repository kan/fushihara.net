{
  "name": "fushihara-blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c ./wrangler.jsonc",
    "//build": "wrangler.jsonc の assets.directory が dist/ を指すので、テストもデプロイもこれが要る",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types -c ./wrangler.jsonc && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "//wrangler": "リポジトリ直下に本体の .wrangler/deploy/config.json があると wrangler が両方を見つけて落ちるので、-c で明示する",
    "//db": "マイグレーションの実体は lily。wrangler.jsonc の migrations_dir が node_modules を直接指している",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c ./wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply DB --remote -c ./wrangler.jsonc",
    "db:seed:local": "wrangler d1 execute DB --local -c ./wrangler.jsonc --file ./seeds/dev.sql",
    "deploy": "npm run build && wrangler deploy -c ./wrangler.jsonc",
    "test:e2e": "playwright test"
  },
  "//dependencies": "CMS の本体は lily (別リポジトリ github.com/kan/lily)。ここに残るのはテーマが使うもの (hono/html) だけ",
  "dependencies": {
    "@kanf/lily": "^0.4.0",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
