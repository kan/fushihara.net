{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fushihara-net",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-23",
  "assets": {
    "binding": "ASSETS",
    // **not_found_handling は指定しない（既定の "none"）。** どのアセットにも
    // 一致しないリクエストを Worker に回すため。Worker が robots.txt と
    // sitemap.xml を組み、`Accept: text/markdown` の 404 には Markdown を返す
    // （worker/pages.ts）。
    //
    // 以前の "404-page" でも、404.html が無い今はローカルの workerd で Worker に
    // 届いた（実測）。ただし 404.html を置いた日にアセット側が答えて Worker に
    // 届かなくなるので、外れたリクエストを Worker に回すと文書化されている
    // "none" にしてある。
    //
    // Workers は既定で assets を先に見るため、API パスとトップページだけ Worker に
    // 流す (Pages の _routes.json 相当)。`/` は `Accept` で HTML と Markdown を
    // 出し分ける（HTML はそのまま ASSETS に渡す）。
    "run_worker_first": ["/api/*", "/"]
  },
  // ブログ (/blog) を配っている別 Worker を直接呼ぶための binding。
  //
  // **同一ゾーンの URL を素の fetch で叩いても、その Worker ルートは再実行されない。**
  // リクエストは origin へ向かい、fushihara.net に origin は無いので 522 になる
  // (本番で踏んだ)。ローカル dev は素の外向き fetch なので気付けない。
  "services": [
    { "binding": "BLOG", "service": "fushihara-blog" }
  ],

  "observability": { "enabled": true }
}
