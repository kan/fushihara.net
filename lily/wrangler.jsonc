{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fushihara-net-lily",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-23",

  // /blog-next* で並走中。**末尾の `*` は必須**で、無いとクエリ付きの URL
  // (`?utm_source=…`) に一致せず本体 Worker へ落ちる (本体で実際に踏んだ)。
  //
  // route は長い方が優先されるので、既存の fushihara.net/blog* より先に一致する。
  // 切り替えのときはここを `fushihara.net/blog*` にして、Astro 側の route を外す。
  "routes": [{ "pattern": "fushihara.net/blog-next*", "zone_name": "fushihara.net" }],

  // D1 と R2 は binding 名で参照する。lily を OSS として配ったときに
  // 「リソース ID を手で埋める」前提にしないため、コードは DB / MEDIA しか知らない。
  //
  // ローカル (miniflare / vitest) はこの値を見ないので、テストと --local の
  // マイグレーションは database_id が何であっても通る。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fushihara-net-lily",
      "database_id": "d2588105-bed3-4baa-94ba-1140241e494e",
      "migrations_dir": "./migrations"
    }
  ],
  // 静的アセットの合流点。`npm run build` が作る (shared/public のコピー +
  // 管理画面のビルド成果物)。**ビルドしていないと wrangler も vitest も動かない。**
  //
  // 静的アセットの URL はディレクトリ直下からの相対 (`/favicon.svg`) になるので、
  // `<mount>/favicon.svg` や `<mount>/admin/…` へは Worker が binding 経由で
  // 読み替えて出す。そのため run_worker_first: true で全部いったん Worker に通す。
  // **route を張るとローカルの host まで実ドメインになる。** wrangler dev は
  // リクエストの origin を route のゾーン (fushihara.net) として渡すので、
  // localhostOnly が「ローカルではない host」として拒否し、管理画面も E2E の
  // フィクスチャ投入も通らなくなる (実際に踏んだ)。ローカルでは localhost を
  // origin として扱わせる。**デプロイには影響しない。**
  "dev": { "host": "localhost" },

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true
  },
  // 画像の最適化。**任意の層**で、無くても添付は R2 の原本で配れる
  // (Deploy to Cloudflare が Images を自動で用意しないので、無い前提を保つ)。
  "images": { "binding": "IMAGES" },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "fushihara-net-lily-media" }
  ],

  // CSS は Worker がバンドルした文字列として配る。site/ が @import ではなく
  // 連結して 1 本にするので、ブラウザから見えるのは <mount>/styles.css だけ。
  "rules": [
    { "type": "Text", "globs": ["**/*.css"] }
  ],

  // Cloudflare Access の設定。**秘密ではない**が deployment ごとに違うので、
  // コードではなくここに置く。空のままだと src/config.ts が localhostOnly
  // アダプタに落ちる (本番は開かないが、Access で守られている状態とは別物)。
  // どちらが選ばれたかは起動時にログへ出る。
  //
  // 並走中は Access のアプリケーションが /blog-next 丸ごとを守っているので、
  // 公開ページもログインしないと見えない (インデックスされる余地が無い)。
  // 切り替えのときに /blog/admin と /blog/api へ絞る。
  "vars": {
    "ACCESS_TEAM": "kanf",
    "ACCESS_AUD": "5f36e8cb80f216e06cf2557fa4b140e2c11ad9ba1b49ea63fe7ab422da1cd542"
  },

  "observability": { "enabled": true }
}
