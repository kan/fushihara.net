{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fushihara-net-lily",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-23",

  // route はまだ張らない。/blog-next* での並走を始めるときに足す
  // (それまでデプロイしないので、書いておくと事故のもとになる)。
  //
  //   "routes": [{ "pattern": "fushihara.net/blog-next*", "zone_name": "fushihara.net" }]
  //
  // route は長い方が優先されるので、既存の fushihara.net/blog* より先に一致する。

  // D1 と R2 は binding 名で参照する。lily を OSS として配ったときに
  // 「リソース ID を手で埋める」前提にしないため、コードは DB / MEDIA しか知らない。
  //
  // database_id は本番の D1 を作るまで未確定。ローカル (miniflare / vitest) は
  // この値を見ないので、テストと --local のマイグレーションはこのまま通る。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fushihara-net-lily",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  // favicon 3 点と ogp.png の実体は本体サイトと共有の shared/public。
  // 静的アセットの URL はディレクトリ直下からの相対 (`/favicon.svg`) になるので、
  // `<mount>/favicon.svg` へは Worker が binding 経由で読み替えて出す。
  // そのため run_worker_first: true で全部いったん Worker に通す。
  "assets": {
    "binding": "ASSETS",
    "directory": "../shared/public",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "fushihara-net-lily-media" }
  ],

  // CSS は Worker がバンドルした文字列として配る。site/ が @import ではなく
  // 連結して 1 本にするので、ブラウザから見えるのは <mount>/styles.css だけ。
  "rules": [
    { "type": "Text", "globs": ["**/*.css"] }
  ],

  // Cloudflare Access の設定。**秘密ではない**が deployment ごとに違うので、
  // コードではなくここに置く。Access のアプリケーションを作ったら実際の値を入れる。
  // 空のままだと認証は必ず失敗する (fail closed) ので、管理画面は開かない。
  "vars": {
    "ACCESS_TEAM": "",
    "ACCESS_AUD": ""
  },

  "observability": { "enabled": true }
}
