{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    // page.evaluate() の中はブラウザで動くので DOM が要る
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  // ビルド設定ファイルもここでまとめて型検査する
  "include": [
    "e2e",
    "src/layout.ts",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
